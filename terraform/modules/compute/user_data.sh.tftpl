#!/bin/bash
set -euxo pipefail

# Look up this server's public IP (IMDSv2) so the k3s certificate is valid for it
TOKEN=$(curl -sX PUT "http://169.254.169.254/latest/api/token" -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
PUBLIC_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" http://169.254.169.254/latest/meta-data/public-ipv4)

curl -sfL https://get.k3s.io | INSTALL_K3S_EXEC="server --tls-san $PUBLIC_IP --tls-san kubernetes --write-kubeconfig-mode 600" sh -

# Install the health check script and its daily cron schedule
mkdir -p /opt/zuri /var/log/zuri
echo "${healthcheck_b64}" | base64 -d > /opt/zuri/healthcheck.sh
chmod 755 /opt/zuri/healthcheck.sh
echo "${health_check_cron} root /opt/zuri/healthcheck.sh >> /var/log/zuri/cron.log 2>&1" > /etc/cron.d/zuri-healthcheck
chmod 644 /etc/cron.d/zuri-healthcheck
